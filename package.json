{
  "name": "draft-hybrid-app",
  "version": "1.0.0",
  "private": true,
  "description": "Draft hybrid Android app (offline, CDN and CDN+CJK-local editions)",
  "scripts": {
    "native-bridge": "node scripts/build-native-bridge.js",
    "check:fonts": "node scripts/check-fonts.js --strict",
    "fonts:cdn-css": "node scripts/gen-cdn-fonts-css.js",
    "postinstall": "node scripts/check-fonts.js",
    "build": "node scripts/build-targets.js local",
    "build:local": "node scripts/build-targets.js local",
    "build:cdn": "node scripts/build-targets.js cdn",
    "build:cdn-local": "node scripts/build-targets.js cdn-local",
    "build:web": "node scripts/build-targets.js web",
    "build:all": "node scripts/build-targets.js local cdn cdn-local web",
    "sync:cdn": "bash scripts/sync-cdn-edition.sh",
    "sync:cdn-local": "bash scripts/sync-cdn-edition.sh cdn-local",
    "sync:web": "bash scripts/sync-web-edition.sh",
    "resources": "npx capacitor-assets generate --android --assetPath resources"
  },
  "devDependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "esbuild": "^0.28.2",
    "katex": "^0.19.1",
    "marked": "^15.0.12"
  },
  "dependencies": {
    "@capacitor/app": "^7.1.2",
    "@capacitor/filesystem": "^7.1.9",
    "@capacitor/share": "^7.0.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
